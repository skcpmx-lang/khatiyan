<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy (Phase 35): financial data must never leave the device.
     Combined with android:allowBackup="false" nothing is excluded because everything is excluded. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
